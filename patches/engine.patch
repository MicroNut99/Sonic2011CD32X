+#ifndef PLAT_H
+#define PLAT_H
+// PORT32X: the platform layer of the Sega CD32X port.
+// plat_host.cpp implements it for the PC host build (frames to PNG, pad scripts,
+// virtual clock, logs); plat_mars.cpp will implement it on the SH2.
+
+// Time: the host build runs on a virtual clock (every frame = 1/60 s).
+unsigned int plat_ticks_ms();
+
+// Video: the engine's 16-bit (RGB565) frame, width x height, pitch in pixels.
+void plat_present(const unsigned short *frame, int width, int height, int pitch);
+
+// Input: the Mega Drive pad bits (see plat_pad bits below).
+enum {
+    PAD_UP = 1 << 0, PAD_DOWN = 1 << 1, PAD_LEFT = 1 << 2, PAD_RIGHT = 1 << 3,
+    PAD_A = 1 << 4, PAD_B = 1 << 5, PAD_C = 1 << 6, PAD_START = 1 << 7,
+    PAD_X = 1 << 8, PAD_Y = 1 << 9, PAD_Z = 1 << 10, PAD_MODE = 1 << 11,
+};
+unsigned int plat_pad();
+
+// Audio: music is a CD track, sound effects are mixed by the platform.
+void plat_music_play(const char *fileName, int loop, unsigned int loopPoint);
+void plat_music_stop();
+void plat_sfx_play(int sfx, int loop);
+void plat_sfx_loaded(int sfx, const char *name, int rate, int channels, int bits, int samples);
+
+// Tile layers: DrawHLineScrollLayer reports, per layer slot, the layer drawn, the layer
+// line shown on screen line 0, and the horizontal layer position of every screen line.
+// plat_layer_begin returns the buffer to draw into (normally the frame passed in).
+unsigned short *plat_layer_begin(int slot, int layer, int tileYPos, unsigned short *frame);
+void plat_layer_line(int slot, int line, int x);
+void plat_layer_end(int slot);
+// PORT32X R1T: the no-draw build writes the slot's per-line positions (SCREEN_YSIZE ints, after
+// plat_layer_begin) straight into this buffer instead of a plat_layer_line call per line; NULL = the
+// platform does not use this slot's lines
+int *plat_layer_lines(int slot);
+
+// S5c: the cart image - arrays that are read-only once a stage is loaded (scripts, chunks,
+// collision) live in the cart on the SH2. plat_cart_data returns where each one is.
+enum { SCD_CART_SCRIPTCODE, SCD_CART_JUMPTABLE, SCD_CART_CHUNKS, SCD_CART_COLLISION, SCD_CART_SCRIPTFRAMES, SCD_CART_ANIMFRAMES,
+       SCD_CART_ANIMLIST, SCD_CART_ARCTAN, SCD_CART_STAGELIST, SCD_CART_TYPENAMES, SCD_CART_GLOBALNAMES,
+       SCD_CART_ANIMFILES, SCD_CART_FONT, SCD_CART_TRIG,
+       SCD_CART_GFXDATA, SCD_CART_TILEGFX, SCD_CART_BLEND, SCD_CART_COUNT }; // S7e: pixels + blend tables
+// REV R4: the console image's part 17 (tools/build_game_data.py appends it): the scene's own data pack - the SH2 reads
